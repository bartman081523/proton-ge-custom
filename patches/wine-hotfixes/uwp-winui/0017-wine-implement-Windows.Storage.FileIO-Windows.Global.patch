+    if (IsEqualGUID(riid, &IID_IDateTimeFormatterFactory))
+    {
+        *ppvObject = &impl->IDateTimeFormatterFactory_iface;
+        return S_OK;
+    }
+
+    /* Fallback: return factory interface */
+    *ppvObject = &impl->IDateTimeFormatterFactory_iface;
+    return S_OK;
+}
