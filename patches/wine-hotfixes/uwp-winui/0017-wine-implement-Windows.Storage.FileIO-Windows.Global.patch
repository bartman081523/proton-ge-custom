+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IDateTimeFormatter_iface.lpVtbl = dtf_vtbl;
+    impl->ref = 1;
+    if (tmpl) lstrcpynW(impl->template, tmpl, ARRAY_SIZE(impl->template));
