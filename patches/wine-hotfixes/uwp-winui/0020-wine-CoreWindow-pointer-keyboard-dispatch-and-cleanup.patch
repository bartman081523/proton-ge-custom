+static const char b64_table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static int b64_val(char c)
+{
+    const char *p = strchr(b64_table, c);
+    return p ? (int)(p - b64_table) : -1;
+}
+
+static char *base64_decode(const char *in, int in_len, int *out_len)
+{
+    int i = 0, j = 0, pad = 0, olen;
+    char *out;
+
+    if (in_len >= 2 && in[in_len - 1] == '=') pad++;
+    if (in_len >= 2 && in[in_len - 2] == '=') pad++;
+    olen = (in_len * 3) / 4 - pad;
+    out = malloc(olen + 1);
+    if (!out) return NULL;
+
+    while (i < in_len)
+    {
+        int v[4], k;
+        for (k = 0; k < 4; k++)
+        {
+            if (i < in_len && in[i] != '=')
+                v[k] = b64_val(in[i++]);
+            else
+            {
+                v[k] = 0;
+                i++;
+            }
+        }
+        if (j < olen) out[j++] = (v[0] << 2) | (v[1] >> 4);
+        if (j < olen) out[j++] = ((v[1] & 0xf) << 4) | (v[2] >> 2);
+        if (j < olen) out[j++] = ((v[2] & 0x3) << 6) | v[3];
+    }
+    out[olen] = '\0';
+    if (out_len) *out_len = olen;
+    return out;
+}
+
+static char *json_get_str(const char *json, const char *key)
+{
+    char pattern[256];
+    const char *p, *end;
+    char *res;
+    int len, ri, i;
+
+    snprintf(pattern, sizeof(pattern), "\"%s\"", key);
+    p = strstr(json, pattern);
+    if (!p) return NULL;
+    p += strlen(pattern);
+    while (*p == ' ' || *p == ':' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+    if (*p != '\"') return NULL;
+    p++;
+    end = p;
+    while (*end && *end != '\"')
+    {
+        if (*end == '\\' && *(end + 1)) end += 2;
+        else end++;
+    }
+    len = end - p;
+    res = malloc(len + 1);
+    ri = 0;
+    for (i = 0; i < len; i++)
+    {
+        if (p[i] == '\\' && p[i+1] == '\"') {
+            res[ri++] = '\"';
+            i++;
+        } else if (p[i] == '\\' && p[i+1] == '\\') {
+            res[ri++] = '\\';
+            i++;
+        } else {
+            res[ri++] = p[i];
+        }
+    }
+    res[ri] = '\0';
+    return res;
+}
