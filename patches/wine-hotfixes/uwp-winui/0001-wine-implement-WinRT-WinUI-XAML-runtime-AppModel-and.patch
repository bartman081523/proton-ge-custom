+// 4. FakeIterator
+typedef struct {
+  IIterator_Package IIterator_Package_iface;
+  LONG ref;
+  int index;
+  int count;
+  FakePackage **packages;
+} FakeIterator;
+
+static inline FakeIterator *
+impl_from_IIterator_Package(IIterator_Package *iface) {
