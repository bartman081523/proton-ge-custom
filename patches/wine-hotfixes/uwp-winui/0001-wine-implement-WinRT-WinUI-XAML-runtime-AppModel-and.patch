+    *out = NULL;
+    return E_OUTOFMEMORY;
+  }
+  impl->IIterable_Package_iface.lpVtbl = &FakeIterable_Vtbl;
+  impl->ref = 1;
+  impl->packages = all_packages;
+  impl->count = table_count;
+  *out = &impl->IIterable_Package_iface;
