+static HRESULT WINAPI storage_file_statics_GetFileFromPathAsync( IStorageFileStatics *iface,
+                                                                HSTRING path,
+                                                                __FIAsyncOperation_1_Windows__CStorage__CStorageFile **operation )
+{
